# Keys (never commit .env)
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Default provider for roles without their own setting
DECKGEN_LLM_PROVIDER=gemini
DECKGEN_MODEL=
# Per-role provider:model (first is primary, the rest are fallbacks when a daily quota is gone). Roles: extractor writer checker critic
# DECKGEN_ROLE_EXTRACTOR=groq:llama-3.3-70b-versatile
# DECKGEN_ROLE_WRITER=groq:openai/gpt-oss-120b
# DECKGEN_ROLE_CHECKER=gemini:gemini-3.5-flash        # a different model family than the writer avoids shared blind spots
# DECKGEN_ROLE_CRITIC=gemini:gemini-3.5-flash
# Free-tier friendly local rate cap (tokens per minute) per provider; provider headers are also honoured
# DECKGEN_TPM_GROQ=6500
# Gates: strict | demoted (see `deckgen checks`)
DECKGEN_GATES=demoted
DECKGEN_PIN_MODELS=0
DECKGEN_NO_CACHE=0
DECKGEN_SEARCH_PROVIDER=tavily
SOFFICE_PATH=
