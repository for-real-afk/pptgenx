# Source before the Anthropic run:  set -a; . config/anthropic_run.env; set +a   (the API key stays in .env)
DECKGEN_ROLE_EXTRACTOR=anthropic:claude-haiku-5-5
DECKGEN_ROLE_WRITER=anthropic:claude-sonnet-5-5
DECKGEN_ROLE_CHECKER=anthropic:claude-sonnet-5-5
DECKGEN_ROLE_CRITIC=anthropic:claude-haiku-5-5
DECKGEN_PIN_MODELS=1
DECKGEN_BUDGET_USD=25
# Photos need a contact for the Wikimedia User-Agent (a URL or address YOU choose). Unset = photos are skipped and the run report says so:
# DECKGEN_CONTACT=
DECKGEN_AGENT_MAX_TOOL_CALLS=120
